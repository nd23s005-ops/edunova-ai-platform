{"resource":{"id":"sd-reference-guide","title":"System Design \u2014 Reference Guide","category":"CS Core","difficulty":"Intermediate","readingTime":"18 min","pages":34,"lastUpdated":"September 2026","tags":["System Design","Architecture Reference"],"heroImage":"https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=1800&q=80","heroSubtitle":"A daily System Design reference \u2014 decision matrices, comparison tables, technology selection guides, and production checklists for working engineers."},"toc":[{"id":"objectives","label":"Learning Objectives"},{"id":"c1","label":"1. Architecture Decision Matrix"},{"id":"c2","label":"2. Scalability Reference"},{"id":"c3","label":"3. Database Selection Guide"},{"id":"c4","label":"4. SQL vs NoSQL"},{"id":"c5","label":"5. Cache Selection"},{"id":"c6","label":"6. Load Balancer Comparison"},{"id":"c7","label":"7. API Design Standards"},{"id":"c8","label":"8. Distributed Systems"},{"id":"c9","label":"9. Cloud Services"},{"id":"c10","label":"10. Security Reference"},{"id":"c11","label":"11. Monitoring Stack"},{"id":"c12","label":"12. Performance Optimization"},{"id":"c13","label":"13. Reliability Patterns"},{"id":"c14","label":"14. Production Checklist"},{"id":"c15","label":"15. Technology Comparison Tables"},{"id":"c16","label":"16. Decision Frameworks"},{"id":"review","label":"Reference Review"},{"id":"faqs","label":"FAQ"},{"id":"glossary","label":"Glossary"},{"id":"references","label":"References"},{"id":"disclaimer","label":"Disclaimer"}],"related":[{"title":"System Design \u2014 Advanced Concepts","tag":"CS Core","time":"32 min"},{"title":"System Design \u2014 Glossary","tag":"CS Core","time":"11 min"},{"title":"System Design \u2014 Cheat Sheet","tag":"CS Core","time":"4 min"}],"html":"<section id=\"objectives\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">Learning Objectives</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li>Build a professional reference library for design reviews.</li>\n          <li>Compare architecture patterns side-by-side.</li>\n          <li>Select appropriate technologies using clear matrices.</li>\n          <li>Improve engineering decisions with structured checklists.</li>\n          <li>Increase productivity by looking up instead of memorising.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"c1\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">1. Architecture Decision Matrix</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Style</th><th class=\"p-2 text-left\">Choose when</th><th class=\"p-2 text-left\">Avoid when</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Modular Monolith\", \"Small team, fast iteration\", \"Independent scaling needed\"]} />\n            <Row cells={[\"Microservices\", \"Many teams, independent lifecycles\", \"Team size < 20\"]} />\n            <Row cells={[\"Serverless\", \"Bursty, unpredictable load\", \"Steady, latency-critical workloads\"]} />\n            <Row cells={[\"Event-Driven\", \"Loose coupling, async workflows\", \"Simple synchronous CRUD\"]} />\n          </tbody>\n        </table>\n        <Figure src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1400&q=80\" caption=\"Figure 1 \u2014 Architecture decision matrix mapped onto a reference enterprise system.\" />\n      </div></section>\n\n      <section id=\"c2\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">2. Scalability Reference</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Symptom</th><th class=\"p-2 text-left\">First lever</th></tr></thead>\n          <tbody>\n            <Row cells={[\"High p99 latency\", \"Add cache / fix pool sizing\"]} />\n            <Row cells={[\"DB CPU saturated\", \"Add read replicas, fix N+1\"]} />\n            <Row cells={[\"Queue backlog\", \"Scale consumers, add backpressure\"]} />\n            <Row cells={[\"Global slowness\", \"CDN static assets, edge routing\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c3\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">3. Database Selection Guide</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Workload</th><th class=\"p-2 text-left\">Recommended</th></tr></thead>\n          <tbody>\n            <Row cells={[\"OLTP with relations\", \"PostgreSQL, MySQL\"]} />\n            <Row cells={[\"Session / KV lookup\", \"Redis, DynamoDB\"]} />\n            <Row cells={[\"Wide-column, high write\", \"Cassandra, ScyllaDB\"]} />\n            <Row cells={[\"Full-text search\", \"OpenSearch / Elasticsearch\"]} />\n            <Row cells={[\"Time series\", \"TimescaleDB, InfluxDB\"]} />\n            <Row cells={[\"Graph relationships\", \"Neo4j, Neptune\"]} />\n            <Row cells={[\"Analytics / OLAP\", \"ClickHouse, BigQuery, Snowflake\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c4\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">4. SQL vs NoSQL</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Aspect</th><th class=\"p-2 text-left\">SQL</th><th class=\"p-2 text-left\">NoSQL</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Schema\", \"Strict\", \"Flexible\"]} />\n            <Row cells={[\"Joins\", \"Native\", \"App-side\"]} />\n            <Row cells={[\"Transactions\", \"Strong\", \"Varies\"]} />\n            <Row cells={[\"Scale-out\", \"Harder\", \"Native\"]} />\n            <Row cells={[\"Best for\", \"Business data\", \"High-volume denormalised\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c5\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">5. Cache Selection</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Need</th><th class=\"p-2 text-left\">Choose</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Rich data types, pub/sub\", \"Redis\"]} />\n            <Row cells={[\"Simple, sharded KV\", \"Memcached\"]} />\n            <Row cells={[\"Global edge cache\", \"Cloudflare / Fastly / CloudFront\"]} />\n            <Row cells={[\"Local in-process\", \"Caffeine (JVM), lru-cache (Node)\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c6\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">6. Load Balancer Comparison</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Type</th><th class=\"p-2 text-left\">Best for</th></tr></thead>\n          <tbody>\n            <Row cells={[\"NLB (L4)\", \"TCP/UDP, ultra-low latency\"]} />\n            <Row cells={[\"ALB (L7)\", \"HTTP, path/header routing, TLS termination\"]} />\n            <Row cells={[\"HAProxy / Nginx / Envoy\", \"Self-hosted L4+L7\"]} />\n            <Row cells={[\"Global anycast LB\", \"Multi-region traffic steering\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c7\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">7. API Design Standards</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li>Version APIs from day one (<code>/v1/...</code>).</li>\n          <li>Use plural nouns, HTTP verbs, appropriate status codes.</li>\n          <li>Idempotency keys on all money-moving POSTs.</li>\n          <li>Consistent error envelopes: <code>{ code, message, details }</code>.</li>\n          <li>Paginate everything that can grow.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"c8\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">8. Distributed Systems</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Concern</th><th class=\"p-2 text-left\">Reference technique</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Leader election\", \"Raft / etcd\"]} />\n            <Row cells={[\"Ordering\", \"Kafka partitions\"]} />\n            <Row cells={[\"Distributed lock\", \"Redlock (with caveats), etcd lease\"]} />\n            <Row cells={[\"Long-running transaction\", \"Saga (orchestrated / choreographed)\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c9\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">9. Cloud Services</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Capability</th><th class=\"p-2 text-left\">AWS</th><th class=\"p-2 text-left\">GCP</th><th class=\"p-2 text-left\">Azure</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Managed K8s\", \"EKS\", \"GKE\", \"AKS\"]} />\n            <Row cells={[\"Serverless func\", \"Lambda\", \"Cloud Functions\", \"Functions\"]} />\n            <Row cells={[\"Object storage\", \"S3\", \"GCS\", \"Blob Storage\"]} />\n            <Row cells={[\"Managed SQL\", \"RDS / Aurora\", \"Cloud SQL / Spanner\", \"Azure SQL\"]} />\n            <Row cells={[\"Managed queue\", \"SQS / SNS\", \"Pub/Sub\", \"Service Bus\"]} />\n          </tbody>\n        </table>\n        <Figure src=\"https://images.unsplash.com/photo-1544197150-b99a580bb7a8?w=1400&q=80\" caption=\"Figure 2 \u2014 Cross-cloud service map: pick capability first, vendor second.\" />\n      </div></section>\n\n      <section id=\"c10\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">10. Security Reference</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li>TLS 1.2+ everywhere, mTLS internally.</li>\n          <li>Secrets in a vault (KMS, Secrets Manager) \u2014 never in Git.</li>\n          <li>Least-privilege IAM audited quarterly.</li>\n          <li>OWASP Top 10 covered by SAST/DAST in CI.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"c11\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">11. Monitoring Stack</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Signal</th><th class=\"p-2 text-left\">Stack</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Metrics\", \"Prometheus + Grafana / Datadog\"]} />\n            <Row cells={[\"Logs\", \"Loki / ELK / Splunk\"]} />\n            <Row cells={[\"Traces\", \"OpenTelemetry + Jaeger / Tempo\"]} />\n            <Row cells={[\"RUM\", \"Datadog RUM / New Relic Browser\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c12\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">12. Performance Optimization</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ol class=\"list-decimal space-y-1 pl-5\">\n          <li>Measure first \u2014 never guess the bottleneck.</li>\n          <li>Fix the biggest single cost before micro-optimising.</li>\n          <li>Cache reads, batch writes, denormalise where it hurts.</li>\n          <li>Push work to the edge / async pipelines.</li>\n          <li>Right-size machines; over-provisioning hides real bugs.</li>\n        </ol>\n      </div></section>\n\n      <section id=\"c13\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">13. Reliability Patterns</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Pattern</th><th class=\"p-2 text-left\">Purpose</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Circuit Breaker\", \"Stop calling a failing dependency\"]} />\n            <Row cells={[\"Bulkhead\", \"Isolate resource pools\"]} />\n            <Row cells={[\"Retry + Backoff + Jitter\", \"Recover from transient errors\"]} />\n            <Row cells={[\"Timeout everywhere\", \"Prevent stuck resources\"]} />\n            <Row cells={[\"Idempotency Key\", \"Safe retries of writes\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c14\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">14. Production Checklist</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li>Runbooks for every alert.</li>\n          <li>SLOs and error budgets defined and published.</li>\n          <li>DR drill executed within the last quarter.</li>\n          <li>Secrets rotated within policy window.</li>\n          <li>Autoscaling tested under load.</li>\n          <li>Rollback proven in staging.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"c15\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">15. Technology Comparison Tables</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <table class=\"w-full border-collapse text-sm\">\n          <thead><tr class=\"border-b\"><th class=\"p-2 text-left\">Category</th><th class=\"p-2 text-left\">Options</th></tr></thead>\n          <tbody>\n            <Row cells={[\"Message brokers\", \"Kafka \u00b7 RabbitMQ \u00b7 NATS \u00b7 SQS \u00b7 Pub/Sub\"]} />\n            <Row cells={[\"API gateways\", \"Kong \u00b7 Envoy \u00b7 APIGee \u00b7 AWS API Gateway\"]} />\n            <Row cells={[\"Service meshes\", \"Istio \u00b7 Linkerd \u00b7 Consul Connect\"]} />\n            <Row cells={[\"Search engines\", \"OpenSearch \u00b7 Elasticsearch \u00b7 Meilisearch \u00b7 Typesense\"]} />\n          </tbody>\n        </table>\n      </div></section>\n\n      <section id=\"c16\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">16. Decision Frameworks</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li><strong>Trade-off triangle:</strong> latency, consistency, availability \u2014 pick two to optimise for.</li>\n          <li><strong>Build vs buy:</strong> if it's not a differentiator, buy managed.</li>\n          <li><strong>Reversibility test:</strong> reversible decisions can be made fast; irreversible ones deserve a design doc.</li>\n          <li><strong>Boring tech budget:</strong> spend novelty carefully \u2014 one exotic dependency at a time.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"review\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">Reference Review</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <h3 class=\"font-semibold\">Daily engineering reference</h3>\n        <p>Bookmark chapters 1, 2, and 14. They cover 80% of the day-to-day design and review workload.</p>\n        <h3 class=\"mt-3 font-semibold\">Architecture decision checklist</h3>\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li>Have you named the invariant this design protects?</li>\n          <li>Have you enumerated three failure modes and their mitigations?</li>\n          <li>Have you sized the load with concrete numbers?</li>\n        </ul>\n        <h3 class=\"mt-3 font-semibold\">Production readiness checklist</h3>\n        <p>Use section 14 verbatim before every launch review.</p>\n        <h3 class=\"mt-3 font-semibold\">Quick lookup tables</h3>\n        <p>Sections 3\u20139 are optimised for grab-and-go decisions during design meetings.</p>\n      </div></section>\n\n      <section id=\"faqs\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">FAQ</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <details class=\"group my-2 rounded-2xl border border-border/60 bg-card p-4 open:shadow-sm\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold\"><span>Should I memorise these tables?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 shrink-0 transition group-open:rotate-90\"><path d=\"m9 18 6-6-6-6\"/></svg></summary><div class=\"mt-3 text-sm text-muted-foreground\">No \u2014 memorise the categories, look up the details.</div></details>\n        <details class=\"group my-2 rounded-2xl border border-border/60 bg-card p-4 open:shadow-sm\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold\"><span>How often is this updated?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 shrink-0 transition group-open:rotate-90\"><path d=\"m9 18 6-6-6-6\"/></svg></summary><div class=\"mt-3 text-sm text-muted-foreground\">Cloud vendor names drift; core patterns are stable across decades.</div></details>\n        <details class=\"group my-2 rounded-2xl border border-border/60 bg-card p-4 open:shadow-sm\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold\"><span>Can I use this during interviews?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 shrink-0 transition group-open:rotate-90\"><path d=\"m9 18 6-6-6-6\"/></svg></summary><div class=\"mt-3 text-sm text-muted-foreground\">Only mentally. Practice referencing tables aloud so they surface naturally.</div></details>\n      </div></section>\n\n      <section id=\"glossary\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">Glossary</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <ul class=\"list-disc space-y-1 pl-5\">\n          <li><strong>OLTP</strong> \u2014 Online Transactional Processing.</li>\n          <li><strong>OLAP</strong> \u2014 Online Analytical Processing.</li>\n          <li><strong>RUM</strong> \u2014 Real User Monitoring.</li>\n          <li><strong>SAST / DAST</strong> \u2014 Static / Dynamic Application Security Testing.</li>\n        </ul>\n      </div></section>\n\n      <section id=\"references\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">References</h2><div class=\"mt-4 space-y-4 text-foreground/90\"><References /></div></section>\n\n      <section id=\"disclaimer\" class=\"scroll-mt-24 pt-10\"><h2 class=\"text-2xl font-bold tracking-tight sm:text-3xl\">Disclaimer</h2><div class=\"mt-4 space-y-4 text-foreground/90\">\n        <p class=\"text-sm text-muted-foreground\">\n          This resource is intended for educational purposes only. Information is compiled from\n          official documentation, academic publications, research papers, industry standards,\n          and trusted educational resources. System Design principles, cloud platforms,\n          distributed systems, Kubernetes ecosystems, and engineering best practices evolve\n          continuously \u2014 readers should consult official documentation for the latest guidance\n          and implementation recommendations. All trademarks, product names, logos, and\n          intellectual property belong to their respective owners.\n        </p>\n      </div></section>"}